# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AGENTROUTER_API_KEY: Required for AgentRouter API calls (Claude 4.7, Claude 5.0, ChatGPT 5.6, etc.)
AGENTROUTER_API_KEY="MY_AGENTROUTER_API_KEY"

# AGENTROUTER_BASE_URL: Optional AgentRouter API base endpoint URL (Defaults to https://api.agentrouter.ai/v1 or https://agentrouter.org/v1)
AGENTROUTER_BASE_URL="https://api.agentrouter.ai/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

